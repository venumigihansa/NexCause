PORT=8080
DATABASE_URL="postgresql://deployment_manager:deployment_manager@localhost:5432/deployment_manager"
DEFAULT_LOOKBACK_MINUTES=10
DEFAULT_LOOKAHEAD_MINUTES=2
MAX_RECURSION_DEPTH=3
MAX_LOG_LINES=500
MAX_SAMPLES=120
MAX_SPANS=100
PROMETHEUS_URL=
TEMPO_URL=
LOG_BACKEND_URL=
KUBERNETES_IN_CLUSTER=true
KUBERNETES_API_URL=https://kubernetes.default.svc
KUBERNETES_BEARER_TOKEN=
KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
POD_NAMESPACE=
HTTP_TIMEOUT_SECONDS=15
