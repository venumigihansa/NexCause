generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppSourceType {
  image
  git
}

enum DeploymentStatus {
  creating
  running
  failed
  stopped
  deleted
}

enum BuildStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum BuildStrategy {
  dockerfile
  buildpack
}

enum RuntimeConfigType {
  env
  secret
  file
}

enum IncidentStatus {
  open
  resolved
}

enum IncidentSeverity {
  info
  warning
  critical
}

enum IncidentSource {
  manual
  automatic
}

enum RcaRunStatus {
  pending
  running
  completed
  failed
}

enum RcaRunSource {
  manual
  automatic
}

enum WorkspaceStatus {
  active
  suspended
  deleted
}

model Workspace {
  id                     String                   @id @default(cuid())
  asgardeoOrganizationId String                   @unique
  displayName            String
  status                 WorkspaceStatus          @default(active)
  kubernetesNamespace    String                   @unique
  memberships            WorkspaceMembership[]
  sessions               AuthSession[]
  auditEvents            AuditEvent[]
  apps                   App[]
  deployments            Deployment[]
  healthSamples          DeploymentHealthSample[]
  incidents              Incident[]
  rcaRuns                RcaRun[]
  rcaRunEvents           RcaRunEvent[]
  agentThreads           RcaAgentThread[]
  chatMessages           RcaChatMessage[]
  evidenceSnapshots      EvidenceSnapshot[]
  runtimeConfigs         RuntimeConfig[]
  builds                 Build[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
}

model IdentityUser {
  id          String                @id @default(cuid())
  subject     String                @unique
  email       String?
  displayName String?
  memberships WorkspaceMembership[]
  sessions    AuthSession[]
  auditEvents AuditEvent[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model WorkspaceMembership {
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles       String[]     @default([])
  scopes      String[]     @default([])
  lastSeenAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@id([workspaceId, userId])
  @@index([userId])
}

model AuthLoginAttempt {
  stateHash             String   @id
  nonce                 String
  codeVerifierEncrypted String
  returnTo              String?
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  @@index([expiresAt])
}

model AuthSession {
  idHash                String       @id
  userId                String
  user                  IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizationId        String
  roles                 String[]     @default([])
  scopes                String[]     @default([])
  csrfToken             String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  idTokenEncrypted      String?
  accessTokenExpiresAt  DateTime?
  idleExpiresAt         DateTime
  absoluteExpiresAt     DateTime
  lastSeenAt            DateTime     @default(now())
  createdAt             DateTime     @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model AuditEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actor        IdentityUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?
  resourceId   String?
  outcome      String
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model App {
  id           String        @id @default(cuid())
  workspaceId  String        @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  displayName  String
  sourceType   AppSourceType @default(image)
  image        String?
  defaultPort  Int?
  repoUrl      String?
  branch       String?
  buildContext String?
  dockerfilePath String?
  deployments  Deployment[]
  builds       Build[]
  incidents    Incident[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
}

model Deployment {
  id                    String             @id @default(cuid())
  workspaceId           String             @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId                 String
  app                   App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  buildId               String?
  build                 Build?             @relation(fields: [buildId], references: [id], onDelete: SetNull)
  namespace             String
  image                 String
  replicas              Int
  desiredReplicas       Int                @default(1)
  lastNonZeroReplicas   Int?
  port                  Int
  status                DeploymentStatus   @default(creating)
  kubernetesDeployment  String
  kubernetesService     String
  kubernetesConfigMap   String?
  kubernetesFileConfigMap String?
  kubernetesSecret      String?
  kubernetesSecretFiles String?
  runtimeConfigs        RuntimeConfig[]
  evidenceSnapshots     EvidenceSnapshot[]
  healthSamples         DeploymentHealthSample[]
  incidents             Incident[]
  rcaRuns               RcaRun[]
  stoppedAt             DateTime?
  lastRestartedAt       DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([appId])
  @@index([buildId])
  @@index([namespace])
  @@unique([id, workspaceId])
}

model DeploymentHealthSample {
  id                 String     @id @default(cuid())
  workspaceId        String     @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deploymentId       String
  deployment         Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status             String
  desiredReplicas    Int
  readyReplicas      Int
  availableReplicas  Int
  podCount           Int
  warningEventCount  Int
  restartCount       Int
  data               Json
  incidents          Incident[]
  collectedAt        DateTime   @default(now())

  @@index([deploymentId, collectedAt])
  @@index([collectedAt])
  @@unique([id, workspaceId])
}

model Incident {
  id                    String                  @id @default(cuid())
  workspaceId           String                  @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId                 String
  app                   App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  deploymentId          String
  deployment            Deployment              @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status                IncidentStatus          @default(open)
  severity              IncidentSeverity        @default(warning)
  source                IncidentSource
  ruleKey               String?
  title                 String
  summary               String?
  metadata              Json?
  latestHealthSampleId  String?
  latestHealthSample    DeploymentHealthSample? @relation(fields: [latestHealthSampleId], references: [id], onDelete: SetNull)
  rcaRuns               RcaRun[]
  openedAt              DateTime                @default(now())
  resolvedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([appId])
  @@index([deploymentId, status])
  @@index([latestHealthSampleId])
  @@index([status])
  @@unique([id, workspaceId])
}

model RcaRun {
  id                 String            @id @default(cuid())
  workspaceId        String            @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incidentId         String
  incident           Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  deploymentId       String
  deployment         Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  evidenceSnapshotId String?
  evidenceSnapshot   EvidenceSnapshot? @relation(fields: [evidenceSnapshotId], references: [id], onDelete: SetNull)
  status             RcaRunStatus      @default(pending)
  source             RcaRunSource
  result             Json?
  errorMessage       String?
  agentThreads       RcaAgentThread[]
  events             RcaRunEvent[]
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([incidentId])
  @@index([deploymentId])
  @@index([evidenceSnapshotId])
  @@index([status])
  @@unique([id, workspaceId])
}

model RcaRunEvent {
  id          String    @id @default(cuid())
  workspaceId String    @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rcaRunId    String
  rcaRun      RcaRun    @relation(fields: [rcaRunId], references: [id], onDelete: Cascade)
  type        String
  data        Json?
  createdAt   DateTime  @default(now())

  @@index([rcaRunId, createdAt])
  @@unique([id, workspaceId])
}

model RcaAgentThread {
  id                  String           @id @default(cuid())
  workspaceId         String           @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rcaRunId            String
  rcaRun              RcaRun           @relation(fields: [rcaRunId], references: [id], onDelete: Cascade)
  checkpointThreadId  String
  status              String           @default("open")
  messages            RcaChatMessage[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([rcaRunId])
  @@index([checkpointThreadId])
  @@index([status])
  @@unique([id, workspaceId])
}

model RcaChatMessage {
  id        String         @id @default(cuid())
  workspaceId String       @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threadId  String
  thread    RcaAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([threadId, createdAt])
  @@index([role])
  @@unique([id, workspaceId])
}

model EvidenceSnapshot {
  id            String     @id @default(cuid())
  workspaceId   String     @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deploymentId  String
  deployment    Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status        String
  summary       String?
  data          Json
  rcaRuns       RcaRun[]
  createdAt     DateTime   @default(now())

  @@index([deploymentId])
  @@index([createdAt])
  @@unique([id, workspaceId])
}

model RuntimeConfig {
  id            String            @id @default(cuid())
  workspaceId   String            @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deploymentId  String
  deployment    Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type          RuntimeConfigType
  data          Json
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([deploymentId])
  @@unique([id, workspaceId])
}

model Build {
  id             String      @id @default(cuid())
  workspaceId    String      @default(dbgenerated("current_setting('app.workspace_id')"))
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId          String
  app            App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  deployments    Deployment[]
  status         BuildStatus @default(pending)
  strategy       BuildStrategy @default(dockerfile)
  repoUrl        String
  branch         String
  buildContext   String
  dockerfilePath String?
  image          String?
  kubernetesJob  String?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([appId])
  @@index([status])
  @@unique([id, workspaceId])
}
