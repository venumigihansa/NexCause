generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppSourceType {
  image
  git
}

enum DeploymentStatus {
  creating
  running
  failed
  stopped
  deleted
}

enum BuildStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum BuildStrategy {
  dockerfile
  buildpack
}

enum RuntimeConfigType {
  env
  secret
  file
}

model App {
  id           String        @id @default(cuid())
  name         String        @unique
  displayName  String
  sourceType   AppSourceType @default(image)
  image        String?
  defaultPort  Int?
  repoUrl      String?
  branch       String?
  buildContext String?
  dockerfilePath String?
  deployments  Deployment[]
  builds       Build[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Deployment {
  id                    String             @id @default(cuid())
  appId                 String
  app                   App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  buildId               String?
  build                 Build?             @relation(fields: [buildId], references: [id], onDelete: SetNull)
  namespace             String
  image                 String
  replicas              Int
  desiredReplicas       Int                @default(1)
  lastNonZeroReplicas   Int?
  port                  Int
  status                DeploymentStatus   @default(creating)
  kubernetesDeployment  String
  kubernetesService     String
  kubernetesConfigMap   String?
  kubernetesFileConfigMap String?
  kubernetesSecret      String?
  kubernetesSecretFiles String?
  runtimeConfigs        RuntimeConfig[]
  evidenceSnapshots     EvidenceSnapshot[]
  healthSamples         DeploymentHealthSample[]
  stoppedAt             DateTime?
  lastRestartedAt       DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([appId])
  @@index([buildId])
  @@index([namespace])
}

model DeploymentHealthSample {
  id                 String     @id @default(cuid())
  deploymentId       String
  deployment         Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status             String
  desiredReplicas    Int
  readyReplicas      Int
  availableReplicas  Int
  podCount           Int
  warningEventCount  Int
  restartCount       Int
  data               Json
  collectedAt        DateTime   @default(now())

  @@index([deploymentId, collectedAt])
  @@index([collectedAt])
}

model EvidenceSnapshot {
  id            String     @id @default(cuid())
  deploymentId  String
  deployment    Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status        String
  summary       String?
  data          Json
  createdAt     DateTime   @default(now())

  @@index([deploymentId])
  @@index([createdAt])
}

model RuntimeConfig {
  id            String            @id @default(cuid())
  deploymentId  String
  deployment    Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type          RuntimeConfigType
  data          Json
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([deploymentId])
}

model Build {
  id             String      @id @default(cuid())
  appId          String
  app            App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  deployments    Deployment[]
  status         BuildStatus @default(pending)
  strategy       BuildStrategy @default(dockerfile)
  repoUrl        String
  branch         String
  buildContext   String
  dockerfilePath String?
  image          String?
  kubernetesJob  String?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([appId])
  @@index([status])
}
