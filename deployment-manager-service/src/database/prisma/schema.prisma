generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppSourceType {
  image
  git
}

enum DeploymentStatus {
  creating
  running
  failed
  stopped
  deleted
}

enum BuildStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum BuildStrategy {
  dockerfile
  buildpack
}

enum RuntimeConfigType {
  env
  secret
  file
}

enum IncidentStatus {
  open
  resolved
}

enum IncidentSeverity {
  info
  warning
  critical
}

enum IncidentSource {
  manual
  automatic
}

enum RcaRunStatus {
  pending
  running
  completed
  failed
}

enum RcaRunSource {
  manual
  automatic
}

model App {
  id           String        @id @default(cuid())
  name         String        @unique
  displayName  String
  sourceType   AppSourceType @default(image)
  image        String?
  defaultPort  Int?
  repoUrl      String?
  branch       String?
  buildContext String?
  dockerfilePath String?
  deployments  Deployment[]
  builds       Build[]
  incidents    Incident[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Deployment {
  id                    String             @id @default(cuid())
  appId                 String
  app                   App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  buildId               String?
  build                 Build?             @relation(fields: [buildId], references: [id], onDelete: SetNull)
  namespace             String
  image                 String
  replicas              Int
  desiredReplicas       Int                @default(1)
  lastNonZeroReplicas   Int?
  port                  Int
  status                DeploymentStatus   @default(creating)
  kubernetesDeployment  String
  kubernetesService     String
  kubernetesConfigMap   String?
  kubernetesFileConfigMap String?
  kubernetesSecret      String?
  kubernetesSecretFiles String?
  runtimeConfigs        RuntimeConfig[]
  evidenceSnapshots     EvidenceSnapshot[]
  healthSamples         DeploymentHealthSample[]
  incidents             Incident[]
  rcaRuns               RcaRun[]
  stoppedAt             DateTime?
  lastRestartedAt       DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([appId])
  @@index([buildId])
  @@index([namespace])
}

model DeploymentHealthSample {
  id                 String     @id @default(cuid())
  deploymentId       String
  deployment         Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status             String
  desiredReplicas    Int
  readyReplicas      Int
  availableReplicas  Int
  podCount           Int
  warningEventCount  Int
  restartCount       Int
  data               Json
  incidents          Incident[]
  collectedAt        DateTime   @default(now())

  @@index([deploymentId, collectedAt])
  @@index([collectedAt])
}

model Incident {
  id                    String                  @id @default(cuid())
  appId                 String
  app                   App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  deploymentId          String
  deployment            Deployment              @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status                IncidentStatus          @default(open)
  severity              IncidentSeverity        @default(warning)
  source                IncidentSource
  ruleKey               String?
  title                 String
  summary               String?
  metadata              Json?
  latestHealthSampleId  String?
  latestHealthSample    DeploymentHealthSample? @relation(fields: [latestHealthSampleId], references: [id], onDelete: SetNull)
  rcaRuns               RcaRun[]
  openedAt              DateTime                @default(now())
  resolvedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([appId])
  @@index([deploymentId, status])
  @@index([latestHealthSampleId])
  @@index([status])
}

model RcaRun {
  id                 String            @id @default(cuid())
  incidentId         String
  incident           Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  deploymentId       String
  deployment         Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  evidenceSnapshotId String?
  evidenceSnapshot   EvidenceSnapshot? @relation(fields: [evidenceSnapshotId], references: [id], onDelete: SetNull)
  status             RcaRunStatus      @default(pending)
  source             RcaRunSource
  result             Json?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([incidentId])
  @@index([deploymentId])
  @@index([evidenceSnapshotId])
  @@index([status])
}

model EvidenceSnapshot {
  id            String     @id @default(cuid())
  deploymentId  String
  deployment    Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status        String
  summary       String?
  data          Json
  rcaRuns       RcaRun[]
  createdAt     DateTime   @default(now())

  @@index([deploymentId])
  @@index([createdAt])
}

model RuntimeConfig {
  id            String            @id @default(cuid())
  deploymentId  String
  deployment    Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type          RuntimeConfigType
  data          Json
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([deploymentId])
}

model Build {
  id             String      @id @default(cuid())
  appId          String
  app            App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  deployments    Deployment[]
  status         BuildStatus @default(pending)
  strategy       BuildStrategy @default(dockerfile)
  repoUrl        String
  branch         String
  buildContext   String
  dockerfilePath String?
  image          String?
  kubernetesJob  String?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([appId])
  @@index([status])
}
