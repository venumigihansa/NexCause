PORT=3000
ASGARDEO_ISSUER=https://api.asgardeo.io/t/your-root-organization
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=
ASGARDEO_API_AUDIENCE=
ASGARDEO_ROOT_ORGANIZATION_ID=
ASGARDEO_SCOPES="openid profile email apps:read apps:create deployments:read deployments:write deployments:delete builds:read builds:start logs:read incidents:read incidents:manage rca:read rca:run rca:chat:read rca:chat:write members:manage secrets:write"
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
APP_UI_URL=http://localhost:3000/auth/me
AUTH_POST_LOGOUT_URL=http://localhost:3000/auth/me
APP_UI_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_SESSION_KEY_VERSION=v1
# Generate with: openssl rand -base64 32
AUTH_SESSION_ENCRYPTION_KEY=
INTERNAL_SERVICE_JWT_SECRET=
DATABASE_URL="postgresql://deployment_manager:deployment_manager@localhost:5432/deployment_manager?schema=public&connection_limit=10&pool_timeout=5&connect_timeout=5"
# REGISTRY_URL is optional; do not put production registry credentials here.
REGISTRY_URL=
DEFAULT_KUBERNETES_NAMESPACE=apps
LOCAL_REGISTRY_HOST=localhost:5001
LOCAL_REGISTRY_CLUSTER=kind-registry:5000
BUILDPACK_BUILDER_IMAGE=gcr.io/buildpacks/builder
BUILDPACK_RUNNER_IMAGE=localhost:5001/deployment-manager-buildpack-runner:latest
OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-opentelemetry-collector.observability.svc.cluster.local:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
HEALTH_SAMPLE_INTERVAL_SECONDS=60
HEALTH_SAMPLE_RETENTION_MINUTES=60
INCIDENT_DETECTION_ENABLED=true
INCIDENT_DETECTION_INTERVAL_SECONDS=60
AUTO_RCA_ENABLED=true
RCA_EVIDENCE_LOOKBACK_MINUTES=10
RCA_EVIDENCE_LOOKAHEAD_MINUTES=2
RCA_MCP_SERVER_URL=http://rca-mcp-server.deployment-manager.svc.cluster.local/mcp
RCA_MCP_SERVER_PORT=8080
RCA_AGENT_SERVICE_URL=http://rca-agent-service.deployment-manager.svc.cluster.local
RCA_AGENT_ENABLED=true
RCA_AGENT_TRIGGER_MODE=async
RCA_LLM_PROVIDER=gemini
RCA_LLM_MODEL=gemini-1.5-flash
RCA_LLM_API_KEY=
LANGGRAPH_CHECKPOINT_DB_URL=
PROMETHEUS_URL=http://prometheus-server.observability.svc.cluster.local
TEMPO_URL=http://tempo.observability.svc.cluster.local:3100
LOG_BACKEND_URL=http://loki.observability.svc.cluster.local:3100
MAX_RECURSION_DEPTH=3
MAX_LOG_LINES=500
MAX_SAMPLES=120
MAX_SPANS=100
